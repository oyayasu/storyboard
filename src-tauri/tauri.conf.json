{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyboard Studio Next",
  "version": "0.3.12",
  "identifier": "local.filipe.storyboardstudio.next",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Storyboard Studio Next — 0.3.12",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 670,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
